{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEV_MODE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_SAUDI_API_URL": "",
        "EXPO_PUBLIC_SAUDI_STAGE": "PRELAUNCH"
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_DEV_MODE": "false",
        "EXPO_PUBLIC_SAUDI_API_URL": "",
        "EXPO_PUBLIC_SAUDI_STAGE": "PRELAUNCH"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
